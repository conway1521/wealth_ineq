__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Caches
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Raw / interim data are not redistributed; release artifacts ARE checked in
data/raw/*
!data/raw/.gitkeep
# HFCS publishes its Statistical Tables under terms permitting
# redistribution; we keep them in-repo so the converter is reproducible
# without each contributor re-downloading from the ECB.
!data/raw/hfcs/
!data/raw/hfcs/*.xlsx
# SCF chartbook tables (Federal Reserve, US public domain).
!data/raw/scf/
!data/raw/scf/*.xlsx
!data/raw/scf/*.csv
!data/raw/scf/.gitkeep
# DFA quarterly dataset (Federal Reserve, US public domain).
!data/raw/dfa/
!data/raw/dfa/*.zip
!data/raw/dfa/*.csv
!data/raw/dfa/.gitkeep
# OECD Wealth Distribution dataset (OECD, public).
!data/raw/oecd/
!data/raw/oecd/*.csv
!data/raw/oecd/*.xlsx
!data/raw/oecd/.gitkeep
# LWS Gini series (UK Data Service / LIS; check licence before committing).
!data/raw/lws/
!data/raw/lws/*.csv
!data/raw/lws/*.xlsx
!data/raw/lws/*.dta
!data/raw/lws/.gitkeep
data/interim/*
!data/interim/.gitkeep

# OS
.DS_Store
